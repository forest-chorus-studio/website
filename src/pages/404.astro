---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config';
---

<BaseLayout title={`Page not found — ${site.name}`}>
  <section class="container-wide flex min-h-[60vh] flex-col items-center justify-center text-center reveal">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 font-serif text-4xl text-charcoal sm:text-5xl">This thread ran out.</h1>
    <p class="mt-4 max-w-md font-body text-base leading-relaxed text-charcoal/70">
      The page you’re looking for isn’t here — but the gallery is always open.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">Back home</a>
      <a href="/gallery" class="btn-outline">Explore the gallery</a>
    </div>
  </section>
</BaseLayout>
