---
import { futureLinks } from '../config';
---

<section class="container-wide py-20 reveal">
  <p class="eyebrow">On the Horizon</p>
  <h2 class="section-title mt-3">Coming Soon</h2>
  <p class="mt-4 max-w-prose font-body text-base leading-relaxed text-charcoal/70">
    Stay tuned for updates on licensing, collaborations, and more.
  </p>
  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {futureLinks.map((f) => (
      <div class="card flex h-full flex-col">
        <span class="flex h-11 w-11 items-center justify-center rounded-full bg-sage/15 text-sage-dark" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" strokeLinecap="round" strokeLinejoin="round"><path d="M12 2v4M12 18v4M2 12h4M18 12h4M5 5l3 3M16 16l3 3M5 19l3-3M16 8l3-3"/></svg>
        </span>
        <h3 class="mt-5 font-sans text-lg font-semibold text-charcoal">{f.label}</h3>
        <p class="mt-2 font-body text-sm leading-relaxed text-charcoal/70">{f.description}</p>
        <span class="mt-auto pt-4 text-xs font-semibold uppercase tracking-[0.2em] text-charcoal/40">Soon</span>
      </div>
    ))}
  </div>
</section>
