---
import { Image } from 'astro:assets';

export interface Props {
  image: ImageMetadata;
  alt: string;
  title: string;
  caption?: string;
  href?: string;
  aspect?: string;
}

const { image, alt, title, caption, href = '#', aspect = 'aspect-[4/5]' } = Astro.props;
---

<a href={href} class="group block reveal" aria-label={title}>
  <div class:list={['relative overflow-hidden rounded-2xl bg-cream ring-1 ring-charcoal/5', aspect]}>
    <Image
      src={image}
      alt={alt}
      widths={[300, 500, 760]}
      sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
    />
    <div class="absolute inset-0 flex items-end bg-gradient-to-t from-charcoal/60 via-charcoal/0 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100">
      <div class="p-5">
        <p class="font-serif text-lg text-offwhite">{title}</p>
        {caption && <p class="mt-1 text-sm text-offwhite/80">{caption}</p>}
      </div>
    </div>
  </div>
  <p class="mt-3 font-sans text-sm font-medium text-charcoal group-hover:text-sage-dark">
    {title}
    {caption && <span class="block text-charcoal/55">· {caption}</span>}
  </p>
</a>
