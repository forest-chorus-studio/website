---
import { site, links, futureLinks } from '../config';

const year = site.copyrightYear;
const socials = [
  { key: 'etsy', label: 'Etsy', href: links.etsy, icon: 'etsy' },
  { key: 'instagram', label: 'Instagram', href: links.instagram, icon: 'instagram' },
  { key: 'pinterest', label: 'Pinterest', href: links.pinterest, icon: 'pinterest' },
].filter((s) => s.href);
---

<footer class="mt-24 bg-cream text-charcoal">
  <div class="container-wide grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <p class="font-serif text-2xl text-charcoal">{site.name}</p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-charcoal/70">
        {site.description}
      </p>
      <div class="mt-5 flex items-center gap-3">
        {socials.map((s) => (
          <a
            href={s.href}
            rel="noopener noreferrer"
            target="_blank"
            aria-label={s.label}
            class="flex h-10 w-10 items-center justify-center rounded-full bg-offwhite text-charcoal/70 ring-1 ring-charcoal/10 transition-colors hover:bg-sage hover:text-offwhite"
          >
            {s.icon === 'etsy' && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm2.4 13.8c-2.3 0-3.6-1.5-3.6-3.7 0-2.3 1.5-3.8 3.6-3.8 1.2 0 1.9.3 2.5.8l-.7 1.6c-.4-.3-1-.5-1.6-.5-1 0-1.6.7-1.6 1.9 0 1.2.6 1.9 1.6 1.9.6 0 1.2-.2 1.6-.5l.7 1.6c-.6.5-1.3.7-2.5.7Z"/></svg>
            )}
            {s.icon === 'instagram' && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            )}
            {s.icon === 'pinterest' && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.7 19.3c-.1-.8-.2-2 .0-2.9.2-.7 1.2-4.8 1.2-4.8s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.6 1.3 1.4 0 .9-.6 2.2-.9 3.4-.2.9.5 1.7 1.4 1.7 1.7 0 2.8-2.2 2.8-4.7 0-2-1.3-3.4-3.6-3.4-2.6 0-4.2 2-4.2 4 0 .8.2 1.3.6 1.8.2.2.2.3.1.5l-.2.9c-.1.3-.3.4-.6.2-1.2-.5-1.8-1.9-1.8-3.5 0-2.6 2.2-5.7 6.5-5.7 3.5 0 5.8 2.5 5.8 5.2 0 3.6-2 6.3-4.9 6.3-1 0-1.9-.5-2.2-1.1l-.6 2.3c-.2.8-.7 1.7-1 2.3A10 10 0 1 0 12 2Z"/></svg>
            )}
          </a>
        ))}
      </div>
    </div>

    <div>
      <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.2em] text-sage-dark">Explore</h2>
      <ul class="mt-4 space-y-2 text-sm text-charcoal/70">
        <li><a href="/gallery" class="hover:text-charcoal">Gallery</a></li>
        <li><a href="/about" class="hover:text-charcoal">About</a></li>
        <li><a href="/shop" class="hover:text-charcoal">Shop</a></li>
        <li><a href="/about#contact" class="hover:text-charcoal">Contact</a></li>
      </ul>
    </div>

    <div>
      <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.2em] text-sage-dark">Coming Soon</h2>
      <ul class="mt-4 space-y-2 text-sm text-charcoal/55">
        {futureLinks.map((f) => (
          <li key={f.label} aria-disabled="true">{f.label}</li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-charcoal/10">
    <div class="container-wide flex flex-col items-center justify-between gap-3 py-6 text-xs text-charcoal/55 sm:flex-row">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p class="flex items-center gap-2">
        <span aria-hidden="true">Licensing</span><span aria-hidden="true">·</span>
        <span aria-hidden="true">Press</span><span aria-hidden="true">·</span>
        <span aria-hidden="true">Collaborations</span>
      </p>
    </div>
  </div>
</footer>
